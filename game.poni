let screen_transition = new ScreenTransition{};

let player = new Player {};

class ExpList {
    let all: DynArray[vec2] = [];
    var earned: int = 0;
    var earned_total: int = 0;

    fun reset() {
        all.clear();
        earned = 0;
        earned_total = 0;
    }

    fun add(pos: vec2) {
        all.push(pos);
    }

    fun consume(idx: int) {
        let tmp = all[all.length - 1];
        all[idx] = tmp;
        all.pop_or_panic();

        sound.exp.play();
        //set_sound_volume(sound.exp, 0.3);

        earned += 1;
        earned_total += 1;
    }
}

let exp = new ExpList{};

class Colors {
    var player: vec4 = (1, 1, 1, 1);
    var enemy: vec4 = (1, 1, 1, 1);
    var bg: vec4 = (1, 1, 1, 1);
    var exp: vec4 = (1, 1, 1, 1);

    fun conv(rgb: vec3) -> vec4 {
        // TODO: Swizzling would be very helpful.
        (rgb.0, rgb.1, rgb.2, 1)
    }

    var t = 0.0;
    fun update_dt(dt: float) {
        t += dt * 0.3;
        if t > 1.0 { t -= 1.0; }

        var hsv = (t, 1.0, 0.85);
        player = conv(hsv_to_rgb(hsv));

        exp = conv(hsv_to_rgb(hsv + (0.1, 0, -0.1)));

        hsv.0 += 0.5;
        enemy = conv(hsv_to_rgb(hsv));

        hsv.0 += 0.25;
        bg = conv(hsv_to_rgb(hsv * (1, 1, 0.3)));
    }
}
let colors = new Colors{};

class Weapon {
    var which: int = 0;
    var timer: float = 0;

    // lifted from what was a closure
    var aim_dir: vec2 = (0, 0);

    var up_amount: int = 0;
    var up_rate: int = 0;
    var up_pierce: int = 0;

    let upgrades: DynArray[int] = [];

    fun clear_upgrades() {
        upgrades.clear();
        up_amount = 0;
        up_rate = 0;
        up_pierce = 0;
    }

    fun generate_upgrades(count: int) {
        clear_upgrades();
        for i in 0..count {
            var up = randi_range(0, 3);
            if up > 2 { up = 2; }

            if up == 0 {
                up_amount += 1;
            }
            else if up == 1 {
                up_rate += 1;
            }
            else {
                up_pierce += 1;
            }
            upgrades.push(up);
        }
    }


    fun shoot_temporary(pos: vec2, vel: vec2, lifetime: float, damage: int, pierce: int) -> Bullet {
        var b = bullets.spawn();
        b.vel = vel;
        b.lifetime = lifetime;
        b.damage = damage + up_pierce / 2; // Make piercing upgrade also increase damage
        //print("setting type to ", which);
        b.type = which; // Bullets always use the weapon texture...?
        //print("b.type = ", b.type);
        b.pierce = pierce;
        b.knockback = 1;
        b.set_pos(pos);
        b
    }

    // Shoots from player pos in the aim dir.
    /// TODO: This closure isn't capturing self correctly, I don't think. Manually capture
    /// self.
    // Even putting the self_ here doens't work due to other issues.
    // let self_ = self;
    fun shoot_normal(speed: float, lifetime: float, damage: int, pierce: int) {
        shoot_temporary(player.pos, aim_dir * speed, lifetime, damage, pierce);
    }

    fun weapon_basic() {
        let streams = 1 + up_amount;
        if timer <= 0 { sound.shoot_base.play(); }
        while timer <= 0 {
            timer += 0.36;
            for i in 0..streams {
                //print("HI");
                var theta: float = i;
                theta = theta * 6.28 / streams;
                let dev = vec_rotate(aim_dir, theta);
                let b = shoot_temporary(player.pos, dev * 150, 2, 3, 3 + up_pierce);
                b.knockback = 1.5;
            }
            //shoot_normal(150, 2, 1, 3 + up_pierce);
        }
    }

    fun weapon_shotgun() {
        if timer <= 0 { sound.shoot_shotgun.play(); }

        while timer <= 0 {
            timer += 0.8;
            let extra_dev: float = (up_amount + 1);
            for i in 0..(5 * (1 + up_amount)) {
                let deviation = vec_rotate(aim_dir, randf_range(-0.2 * extra_dev, 0.2 * extra_dev));
                shoot_temporary(player.pos, deviation * 130, 3, 2, 1 + up_pierce);
            }
        }
    }

    fun weapon_rapid() {
        if timer <= 0 { sound.shoot_rapid.play(); }

        while timer <= 0 {
            timer += 0.2;
            let extra_dev: float = (up_amount + 1);

            let deviation = vec_rotate(aim_dir, randf_range(-0.03 * extra_dev, 0.03 * extra_dev));
            shoot_temporary(player.pos, deviation * 200, 4, 1, 1 + up_pierce);
            
            // Shoot additional bullets in completely random directions
            for i in 0..up_amount {
                if randi_range(0, 2) == 0 {
                    let dir = vec_rotate((1, 0), randf_range(0, 6.28));
                    shoot_temporary(player.pos, dir * 190, 4, 1, 1 + up_pierce);
                }
            }
        }
    }

    fun weapon_nova() {
        if timer <= 0 { sound.shoot_nova.play(); }

        while timer <= 0 {
            timer += 2.4;
            let count = 6 * (1 + up_amount);
            let countf: float = count;
            for i in -count..count {
                let i: float = i;
                let offset = i * (3.14159265 / countf);

                let deviation = vec_rotate(aim_dir, offset);
                let speed = lerp(200, 40, abs(i / count));
                shoot_temporary(player.pos, deviation * speed, 1, 1, 1 + up_pierce);
            }
        }
    }

    fun update_dt(dt: float) {
        let self_ = self;

        var aim_delta = screen.mouse() - player.pos;
        aim_dir = norm2(aim_delta);

        timer -= dt * (1 + up_rate * { let x = 0.7; x }); //* 4.0;

        // /// Shoots from player pos in the aim dir.
        // /// TODO: This closure isn't capturing self correctly, I don't think. Manually capture
        // /// self.
        // // Even putting the self_ here doens't work due to other issues.
        // // let self_ = self;
        // fun shoot_normal(speed: float, lifetime: float, damage: int) {
        //     self_.shoot_temporary(player.pos, aim_dir * speed, lifetime, damage);
        // }

        // fun weapon_basic() {
        //     while timer <= 0 {
        //         timer += 0.4;
        //         shoot_normal(150, 2, 1);
        //     }
        // }

        // fun weapon_shotgun() {
        //     while timer <= 0 {
        //         timer += 0.8;
        //         for i in 0..5 {
        //             let deviation = vec_rotate(aim_dir, randf_range(-0.2, 0.2));
        //             self_.shoot_temporary(player.pos, deviation * 130, 1, 1);
        //         }
        //     }
        // }

        // fun weapon_rapid() {
            
        // }

        // fun weapon_nova() {

        // }; // TODO: should functions need to be wrapped in () to be immediately invoked?

        ([weapon_basic, weapon_shotgun, weapon_rapid, weapon_nova][which])()
    }
}

let PLAYER_MAX_HEALTH = 16;

class Player {
    var pos: vec2 = (0, 0);
    var bullet_timer: float = 0;
    var flip_h: bool = false;

    // Cap for unlocking next weapon
    var level_cap: int = 6;
    var level_cap_delta: int = 2;
    var level_cap_delta_delta: float = 0.7;

    var level: int = 1; // Start with immediate-ish upgrade potential

    var min_upgrades: int = 0;
    var max_upgrades: int = 0;

    var health: int = PLAYER_MAX_HEALTH;
    var invince_timer: float = 0.0;

    var impulse: vec2 = (0, 0);

    let weapon = new Weapon{};

    fun reset() {
        pos = (0, 0);
        bullet_timer = 0;
        flip_h = false;
        level_cap = 6;
        level_cap_delta = 2;
        level_cap_delta_delta = 0.7;

        level = 1;
        min_upgrades = 0;
        health = PLAYER_MAX_HEALTH;
        invince_timer = 0;
        impulse = (0, 0);

        weapon.which = 0;
        weapon.timer = 1.5; // Initial delay when game loads
        weapon.clear_upgrades();
    }

    fun inp_left() -> bool { is_key_down(K_LEFT) or is_key_down(K_A) }
    fun inp_right() -> bool { is_key_down(K_RIGHT) or is_key_down(K_D) }
    fun inp_up() -> bool { is_key_down(K_UP) or is_key_down(K_W) }
    fun inp_down() -> bool { is_key_down(K_DOWN) or is_key_down(K_S) }

    fun update_dt(dt: float) {
        var vel: vec2 = norm2((
            if inp_left() { flip_h = true; -1 } else if inp_right() { flip_h = false; 1 } else { 0 },
            if inp_up() { -1 } else if inp_down() { 1 } else { 0 }
        )) * 100;

        vel += impulse;
        impulse = lerp(impulse, (0, 0), 0.1); // NOTE: Not framerate independent but update_dt is basically physics_process

        pos += vel * dt;

        // bullet_timer -= dt;
        // while bullet_timer <= 0 {
        //     bullet_timer += 0.3; //0.05;
        //     var b = bullets.spawn();
            
        //     b.vel = norm2((randf_range(-1, 1), randf_range(-1, 1))) * 110.0;
        //     b.lifetime = 1.2;
        //     b.set_pos(pos);
        // }
        weapon.update_dt(dt);


        var i = 0;
        while i < exp.all.length {
            // Repeatedly check the same index due to the way consuming works.
            while i < exp.all.length and {
                let dif = exp.all[i] - pos;
                dot2(dif, dif) < 14 * 14
            } {
                exp.consume(i);
            } 
            i += 1;
        }

        if exp.earned >= level_cap {
            exp.earned -= level_cap;
            // cubic growth..?
            level_cap += level_cap_delta;
            level_cap_delta += floor(level_cap_delta_delta);
            level_cap_delta_delta += 0.3;
            enemies.level_up();
            // TODO: Increase level_cap
            weapon.which = randi_range(0, 4);
            if weapon.which > 3 {
                weapon.which = 3;
            }

            sound.level_up.play();

            // var upgrades = randi_range(min_upgrades, max_upgrades);
            // if upgrades > max_upgrades { upgrades = max_upgrades };
            weapon.generate_upgrades(min_upgrades);

            level += 1;
            if level % 2 == 0 {
                max_upgrades += 1;
            }
            if level % 2 == 0 {
                min_upgrades += 1;
            }
            //print("new weapon: ", weapon.which);
        }

        if exp.earned_total >= EXP_TO_WIN and not game_won_cont {
            game_state = GS_WIN;
            sound.win.play();
        }

        if invince_timer <= 0 {
            enemies.hash.find_all_in_radius(pos, 12, query_output_buffer);
            if query_output_buffer.length > 0 {
                let enem = query_output_buffer[0];
                let enem = enemies.enemies_perm[enem];
                impulse = norm2(pos - enem.pos) * 250;
                invince_timer = 2.0;
                health -= 1;

                sound.hit_player.play();
            }
        }
        else {
            invince_timer -= dt;
        }

        if health <= 0 and game_state == GS_GAME {
            game_state = GS_FAIL;
            sound.lose.play();
        }
    }

    fun draw() {
        if invince_timer > 0 {
            if invince_timer % 0.2 < 0.1 {
                return; // Flashing anim?
            }
        }
        draw_texture_flip_frame(tex.tiles, pos, flip_h, false, (16 * 4, 16, 16, 16), colors.player)
    }
}

class Enemy {
    var idx: int;
    /// Index that is never reassigned. Used for spatial hash queries.
    let perm_idx: int;
    var alive: bool = true;
    var pos: vec2 = (0, 0);

    var vel: vec2 = (0, 0);

    /// For spatial hash.
    var last_cell: vec2i = (0, 0);
    var health: int = 0;

    var hit_anim_cooldown: float = 0;

    fun set_pos(pos: vec2) {
        self.pos = pos;
        last_cell = enemies.hash.update(perm_idx, last_cell);
    }

    fun update_dt(dt: float) {
        let dir = (player.pos - pos);
        let desired_vel = norm2(dir) * 25.0;

        var accel = desired_vel - vel;
        var max_accel = len2(accel);
        accel = norm2(accel) * 400 * dt;
        if len2(accel) > max_accel {
            vel = desired_vel;
        }
        else {
            vel += accel;
        }

        pos += vel * dt;

        repel_with_others();

        

        bullets.hash.find_all_in_radius(pos, 10, query_output_buffer);
        // if query_output_buffer.length > 0 {
        // print(last_cell, " should be ", floor2(pos / enemies.hash.cell_size), " found ", query_output_buffer.length);
        // }
        var hit = false;
        for i in 0..query_output_buffer.length {
            let bullet = bullets.bullets_perm[query_output_buffer[i]];

            if bullet.add_to_filter(self) {
                // Take one damage... or something
                health -= bullet.damage;
                hit_anim_cooldown = 0.4;
                hit = true;
                
                // Knockback. Knock away from player...?
                vel += norm2(pos - player.pos) * 150 * bullet.knockback;
            }
        }

        last_cell = enemies.hash.update(perm_idx, last_cell);

        if health <= 0 or dot2(dir, dir) > 1000 * 1000 {
            enemies.kill(self);
            if health <= 0 {
                exp.add(pos);
                sound.kill_carrot.play();
            }
        }

        if hit and health > 0 {
            sound.hit_carrot.play();
        }

        if hit_anim_cooldown > 0 { hit_anim_cooldown -= dt; }
    }



    fun draw() {
        let plus = if hit_anim_cooldown > 0 { 16 } else { 0 };
        draw_texture_flip_frame(tex.tiles, pos, false, false, (plus, 32, 16, 16), colors.enemy)
    }

    fun compute_repel_strength(enemy: Enemy) -> vec2 {
        let dir = enemy.pos - pos;
        let len_square = dot2(dir, dir);
        if len_square > 64 * 64 {
            return (0, 0);
        }
        let strength = 0.5 / (1 + 0.0007 * len_square);

        norm2(dir) * -strength
    }

    fun repel_with_others() {
        var offset: vec2 = (0, 0);

        // TODO: Use spatial hash to find candidates.
        // for i in 0..enemies.alive {
        //     let enemy = enemies.enemies[i];
        //     if enemy != self {
        //         offset += compute_repel_strength(enemy);
        //     }
        // }
        enemies.hash.find_all_in_radius(pos, 64, query_output_buffer);
        //print("found ", query_output_buffer.length, " enemies");
        for i in 0..query_output_buffer.length {
            // Must use perm array for queries from spatial hash
            let idx = query_output_buffer[i];
            //print(idx, " ", enemies.enemies_perm.length);
            let enemy = enemies.enemies_perm[idx];
            if enemy != self {
                offset += compute_repel_strength(enemy);
            }
        }

        pos += offset;
        //vel += offset * 20;
    }
}

let CELL_SIZE = 64;
let query_output_buffer: DynArray[int] = []; // Used for spatial hash queries

class EnemyList {
    let enemies: DynArray[Enemy] = [];
    let enemies_perm: DynArray[Enemy] = [];
    let hash: SpatialHash = new SpatialHash { cell_size: CELL_SIZE, type: 0 };
    var alive: int = 0;

    fun spawn() -> Enemy {
        let enemy = if alive < enemies.length {
            alive += 1;
            enemies[alive - 1].alive = true;
            enemies[alive - 1].idx = alive - 1;
            enemies[alive - 1]
        }
        else {
            alive += 1;
            let result = new Enemy { idx: enemies.length, perm_idx: enemies_perm.length };
            enemies.push(result);
            enemies_perm.push(result);
            result
        };

        enemy.last_cell = hash.add(enemy.perm_idx);
        enemy
    }

    fun choose(val1: float, val2: float) -> float {
        if randi_range(0, 2) == 0 { val1 } else { val2}
    }

    fun spawn_random_pos(count: int) {
        for i in 0..count {
            // Some max cap...
            if alive >= 3600 { return; }

            let e = spawn();
            let pos = if randi_range(0, 2) == 0 {
                player.pos + (randf_range(-300, 300), choose(-300, 300))
            }
            else {
                player.pos + (choose(-300, 300), randf_range(-300, 300))
            };
            e.health = 1 + up_health;
            e.vel = (0, 0);
            e.set_pos(pos);
        }
    }

    var spawn_timer = 0.0;
    var spawn_timer_len = 0.7;
    var spawn_count: int = 1;
    var up_health: int = 0;
    var level: int = 0;

    fun level_up() {
        spawn_timer_len *= 0.97;
        level += 1;
        if (level == 5 or level == 9 or level == 12 or level == 14 or level == 16) {
            spawn_count += 1;
        }
        if level % 7 == 0 {
            up_health += 1;
        }
    }

    fun update_dt(dt: float) {
        //return;
        spawn_timer += dt;// * 4.0;

        while spawn_timer >= spawn_timer_len {
            spawn_timer -= spawn_timer_len;
            spawn_random_pos(spawn_count);
        }
    }

    fun kill(b: Enemy) {
        if not b.alive {
            return;
        }

        //print("kill ", b.idx);

        //print("swapping ", alive - 1, " (", bullets[alive - 1].idx, ") with ", b.idx, " - ", (bullets[b.idx] == b));
        var tmp = enemies[alive - 1];
        enemies[alive - 1] = enemies[b.idx];
        enemies[b.idx] = tmp;

        tmp.idx = b.idx;

        b.idx = alive - 1;
        b.alive = false;
        alive -= 1;

        b.last_cell = hash.remove(b.perm_idx, b.last_cell);

        //print("dec -> ", alive);
    }

    fun reset() {
        while alive > 0 {
            kill(enemies[0]);
        }

        spawn_timer = 0.0;
        spawn_timer_len = 0.7;
        spawn_count = 1;
        up_health = 0;
        level = 0;
    }
}

let enemies = new EnemyList{};

class Bullet {
    var idx: int;
    var alive: bool = true;
    var pos: vec2 = (0, 0);
    var vel: vec2 = (0, 0);
    var lifetime: float = 0.0;
    let perm_idx: int;
    var last_cell: vec2i = (0, 0);
    var knockback: float = 1.0;

    // var what = 0;
    // var what1 = 0;
    // var what2 = 0;
    // var what3 = 0;
    // var what4 = 0;
    // var what5 = 0;

    var type: int = 0;
    var damage: int = 0;

    var pierce: int = 0;

    /// Enemies that this bullet isn't allowed to damage again until it is respawned.
    /// (Note that this could be a little bit weird if an enemy itself respwans, but that
    // shouldn't be a big deal because bullets are respawned so frequently).
    var filter: DynArray[Enemy] = [];

    /// Checks if the given enemy is in the filter, and if not, adds it. Returns whether
    /// the enemy was newly added.
    fun add_to_filter(e: Enemy) -> bool {
        for i in 0..filter.length {
            if filter[i] == e {
                //print("returning false");
                return false;
            }
        }

        pierce -= 1;
        //print(lifetime, " -- ", pierce);

        filter.push(e);
        //print(" returning true ");
        return true;
    }

    fun set_pos(pos: vec2) {
        self.pos = pos;
        last_cell = bullets.hash.update(self.perm_idx, last_cell);
        //print(last_cell);
    }

    fun update_dt(dt: float) {
        pos += vel * dt;
        lifetime -= dt;

        last_cell = bullets.hash.update(self.perm_idx, last_cell);
        //print("cell = ", last_cell, " should be ", floor2(pos / bullets.hash.cell_size));
        //print(last_cell);

        if lifetime <= 0 or pierce <= 0 {
            // NOTE: Weird iteration.. but mostly works
            bullets.kill(self);
        }
    }

    fun draw() {
        //print(type, " ", damage);
        draw_texture_flip_frame(tex.tiles, pos, false, false, (type * 16, 3 * 16, 16, 16), colors.player)
    }
}

class BulletList {
    let bullets: DynArray[Bullet] = [];
    let bullets_perm: DynArray[Bullet] = [];
    let hash: SpatialHash = new SpatialHash { cell_size: CELL_SIZE, type: 1 };
    var alive: int = 0;

    fun spawn() -> Bullet {
        let bullet = if alive < bullets.length {
            alive += 1; //print("inc recycle ", alive);
            bullets[alive - 1].alive = true;
            bullets[alive - 1].idx = alive - 1;
            bullets[alive - 1]
        }
        else {
            alive += 1; //print("inc new ", alive);
            let result = new Bullet { idx: bullets.length, perm_idx: bullets_perm.length };
            bullets.push(result);
            bullets_perm.push(result);
            result
        };

        bullet.filter.clear();

        bullet.last_cell = hash.add(bullet.perm_idx);
        bullet
    }

    fun update_dt(dt: float) {
        for i in 0..alive {
            bullets[i].update_dt(dt);
        }
    }

    fun draw() {
        for i in 0..alive {
            bullets[i].draw();
        }
    }

    fun kill(b: Bullet) {
        if not b.alive {
            return;
        }

        //print("kill ", b.idx);

        //print("swapping ", alive - 1, " (", bullets[alive - 1].idx, ") with ", b.idx, " - ", (bullets[b.idx] == b));
        var tmp = bullets[alive - 1];
        bullets[alive - 1] = bullets[b.idx];
        bullets[b.idx] = tmp;

        tmp.idx = b.idx;

        b.idx = alive - 1;
        b.alive = false;
        alive -= 1;

        b.last_cell = hash.remove(b.perm_idx, b.last_cell);

        //print("dec -> ", alive);
    }

    fun reset() {
        while alive > 0 {
            kill(bullets[0]);
        }
    }
}

let bullets = new BulletList{};

fun initialize() {
    //world_loader.load_world(level_list[world_loader.level_idx]);
    // enemies.spawn_random_pos(200);
    //play_sound_looping(sound.music);
    //play_sound_looping(sound.music_menu);
}

fun reset_game() {
    enemies.reset();
    bullets.reset();
    player.reset();
    exp.reset();

    game_won_cont = false;

    stop_sound(sound.music);
    play_sound_looping(sound.music);
}

/// Helper for key just pressed checking due to weird update() system.
class Key {
    var was_down: bool = false;
    var is_down: bool = false;
    var is_just_pressed: bool = false;
    let keycode: int;

    fun update() {
        was_down = is_down;
        is_down = is_key_down(keycode);
        is_just_pressed = is_down and not was_down;
    }
}

let key_esc = new Key { keycode: K_ESCAPE };
let key_p = new Key { keycode: K_P };
let keys = [key_esc, key_p];

let GS_MENU = 0;
let GS_GAME = 1;
let GS_WIN  = 2;
let GS_FAIL = 3;
let GS_PAUSE = 4;
var game_state: int = GS_MENU;

var game_won_cont: bool = false;

/// How much the current menu is currently covering the game state.
var menu_lerp: float = 1.0;
var menu_lerp_t: float = 1.0;

fun update_dt(dt: float) {
    // Update keys for is_just_pressed tracking
    for i in 0..keys.length {
        keys[i].update();
    }
    // print(enemies.hash.aabb);
    // print(bullets.hash.aabb);
    // print(player.pos);

    let music_volume: float = 0.8;

    set_sound_volume(sound.music, music_volume * (1.0 - menu_lerp));
    //set_sound_volume(sound.music_menu, music_volume * menu_lerp);

    colors.update_dt(dt);
    
    screen_transition.update_dt(dt);
    //world_loader.tick();

    //world.pre_physics_step();
    //print(player.level, " ", exp.earned_total, " ", exp.earned_total - exp.earned);

    if game_state == GS_GAME {
        enemies.update_dt(dt);

        for i in 0..enemies.alive {
            let e = enemies.enemies[i];
            e.update_dt(dt);
        }
        

        bullets.update_dt(dt);

        player.update_dt(dt);

        menu_lerp_t = clampf(menu_lerp_t - 2.0 * dt, 0, 1);
        menu_lerp = ease_out_cubic(menu_lerp_t);

        if key_esc.is_just_pressed or key_p.is_just_pressed {
            game_state = GS_PAUSE;
        }
    }
    else {
        if game_state == GS_MENU {
            if button_play.update(dt) {
                reset_game();
                game_state = GS_GAME;
            }
        }
        if game_state == GS_FAIL {
            if button_menu.update(dt) {
                game_state = GS_MENU;
            }
            if button_retry.update(dt) {
                reset_game();
                game_state = GS_GAME;
            }
        }
        if game_state == GS_WIN {
            if button_continue.update(dt) {
                game_won_cont = true;
                game_state = GS_GAME; // No reset
            }
            if button_done.update(dt) {
                game_state = GS_MENU;
            }
        }
        if game_state == GS_PAUSE {
            if button_continue.update(dt) {
                game_state = GS_GAME; // No reset, but also no game_win_cont
            }
            if button_menu.update(dt) {
                game_state = GS_MENU;
            }
            if key_esc.is_just_pressed or key_p.is_just_pressed {
                game_state = GS_GAME;
            }
        }
        menu_lerp_t = clampf(menu_lerp_t + 2.0 * dt, 0, 1);
        menu_lerp = ease_in_cubic(menu_lerp_t);
    }

    sound.update_post();
}

fun draw_grass_bg() {
    let min = floor2((player.pos - screen.target_size / 2) / 16);
    let max = ceil2((player.pos + screen.target_size / 2) / 16);

    for i in min.x..max.x {
        for j in min.y..max.y {
            //if i % 2 != j % 2 { continue; }
            let tile = (i + j) % 4;
            let tile = ((4, 0) + tile) * 16;
            draw_texture_flip_frame(tex.tiles, (i, j) * 16, false, false, (tile.0, tile.1, 16, 16), colors.bg);
            //draw_rectangle((i * 16, j * 16), (16, 16), (#c8c8c8ff));
        }
    }
}

fun draw_exp() {
    let min = player.pos - screen.target_size / 2 - 16;
    let max = player.pos + screen.target_size / 2 + 16;

    for i in 0..exp.all.length {
        let pos = exp.all[i];
        if pos.x < min.x or pos.y < min.y or pos.x > max.x or pos.y > max.y { continue; }
        draw_texture_flip_frame(tex.tiles, exp.all[i], false, false, (5 * 16, 1 * 16, 16, 16), colors.exp);
    }
}

fun draw() {
    // camera_controller.ready_draw((player.actor.collider.pos + (8, 8)));
    screen.target_offset = -player.pos;
    screen.update();

    draw_grass_bg();

    draw_exp();

    //world_loader.draw_bg();
    //world_loader.draw();

    for i in 0..enemies.alive {
        let e = enemies.enemies[i];
        e.draw();
    }

    bullets.draw();

    player.draw();


    draw_ui();
    //screen_transition.draw();
    draw_menu();
}

let EXP_TO_WIN = 1016;

fun draw_frame(top_left: vec2, use_thick_bottom: bool) {
    let size = screen.target_size;
    draw_line(top_left + (0, 0), top_left + (size.x, 0), 2, colors.player);
    draw_line(top_left + (0, size.y), top_left + (size.x, size.y), 2, colors.player);
    draw_line(top_left + (0, 0), top_left + (0, size.y), 2, colors.player);
    draw_line(top_left + (size.x, 0), top_left + (size.x, size.y), if use_thick_bottom { 2 } else { 1 }, colors.player);
}

fun draw_ui() {
    let size = screen.target_size;
    let top_left = -screen.target_offset - size / 2;

    let bar_offset = size.y - 18;
    draw_rectangle(top_left + (0, bar_offset), (size.x, size.y - bar_offset), (#000f));

    draw_frame(top_left, true);

    
    draw_line(top_left + (0, bar_offset), top_left + (size.x, bar_offset), 1, colors.player);
    
    draw_line(top_left + (size.x / 2, bar_offset), top_left + (size.x / 2, bar_offset + 11), 1, colors.player);

    var exp_percent = exp.earned / { let x: float = player.level_cap; x };
    exp_percent = clampf(exp_percent, 0, 1);
    let bar_pos = top_left + (2, bar_offset + 2);
    let bar_max_size = ((size.x - 4) / 2, 9);
    let bar_size = (bar_max_size.0 * exp_percent, bar_max_size.1);
    draw_rectangle(bar_pos, bar_size, colors.player);

    exp_percent = exp.earned_total / { let x: float = EXP_TO_WIN; x };
    exp_percent = clampf(exp_percent, 0, 1);
    let bar_max_size = (size.x - 4, 4);
    let bar_size = (bar_max_size.0 * exp_percent, 4);
    draw_rectangle(bar_pos + (0, 10), bar_size, colors.player);

    let upgrade_pos = bar_pos + (-1, -2 - 16);
    // Draw the frame + the current weapon
    draw_texture_flip_frame(tex.tiles, upgrade_pos, false, false, (0, 5 * 16, 16, 16), colors.player);
    draw_texture_flip_frame(tex.tiles, upgrade_pos, false, false, (player.weapon.which * 16, 3 * 16, 16, 16), colors.player);
    let upgrade_pos = upgrade_pos + (16, 0);
    for i in 0..player.weapon.upgrades.length {
        let upgrade = player.weapon.upgrades[i];
        draw_texture_flip_frame(tex.tiles, upgrade_pos + (i * 16, 0), false, false, (upgrade * 16, 4 * 16, 16, 16), colors.player);
    }

    let bar_pos = top_left + (2 + size.x / 2, bar_offset + 2);
    let bar_max_size = ((size.x - 4) / 2 - 2, 9);
    exp_percent = player.health / { let x: float = PLAYER_MAX_HEALTH; x };
    exp_percent = clampf(exp_percent, 0, 1);
    let bar_size = (bar_max_size.0 * exp_percent, bar_max_size.1);

    draw_rectangle(bar_pos, bar_size, colors.player);

}


class Button {
    var pos: vec2i;
    var frame: vec4;

    var hovered: bool = false;
    var mouse_pressed_on: bool = false;

    var muted: bool = false;

    fun in_rect(p: vec2, rpos: vec2, size: vec2) -> bool {
        if (p.x < rpos.x) or (p.y < rpos.y) {
            return false;
        }
        if (p.x > rpos.x + size.x) or (p.y > rpos.y + size.y) {
            return false;
        }

        return true;
    }

    fun button_disabled() -> bool {
        return false;
    }

    fun update(dt: float) -> bool {
        var mouse = screen.mouse() + screen.target_size / 2 + screen.target_offset;
        var pressed_this_frame = false;
        let was_hovered = hovered;

        hovered = false;
        var mouse_in_rect = in_rect(mouse, pos, (16 * 3, 16));

        let disabled = button_disabled();

        if mouse_in_rect {
            hovered = true;
        }

        if hovered {
            if is_mouse_button_pressed(MOUSE_LEFT) {
                if not disabled {
                    mouse_pressed_on = true;
                }
            }
        }

        if mouse_pressed_on and is_mouse_button_released(MOUSE_LEFT) {
            // Only call the callback if we're still on the button when we release it
            if mouse_in_rect {
                if not disabled {
                    sound.button.play();
                    pressed_this_frame = true;
                }
            }

            // Either way, we're no longer pressed on.
            mouse_pressed_on = false;
        }

        if not pressed_this_frame and (hovered and not was_hovered) {
            sound.button_hover.play();
        }

        pressed_this_frame
    }

    fun draw(top_left: vec2) {
        //var brightness = if mouse_pressed_on { 0.7 } else { if hovered { 1 } else { 0.8 } };

        // let disabled = button_disabled();
        // if disabled {
        //     brightness = 0.70;
        // }

        var frame = frame;
        if hovered { frame.x += 16 * 3; }

        draw_texture_flip_frame(tex.tiles, top_left + pos, false, false,
            frame, colors.player);
    }
}

let button_play = new Button {
    pos: (136, 140),
    frame: (0, 16 * 8, 16 * 3, 16),
};

let button_retry = new Button {
    pos: (136, 140),
    frame: (0, 16 * 10, 16 * 3, 16),
};

let button_menu = new Button {
    pos: (136, 140 + 18),
    frame: (0, 16 * 11, 16 * 3, 16),
};

let button_done = new Button {
    pos: (136, 140 + 18),
    frame: (0, 16 * 9, 16 * 3, 16),
};

let button_continue = new Button {
    pos: (136, 140),
    frame: (0, 16 * 14, 16 * 3, 16),
};

fun draw_menu() {
    let size = screen.target_size;
    var top_left = -screen.target_offset - size / 2;

    top_left.y -= size.y * (1.0 - menu_lerp);
    draw_rectangle(top_left, size, (#000f));
    draw_frame(top_left, menu_lerp >= 1.0);

    if game_state == GS_MENU {
        let menu_size = (6, 2) * 16;
        let pos = top_left + (size - menu_size) / 2;
        draw_texture_flip_frame(tex.tiles, pos, false, false,
            (0, 6 * 16, menu_size.x, menu_size.y), colors.player);

        button_play.draw(top_left);
    }
    else if game_state == GS_FAIL {
        let menu_size = (4, 1) * 16;
        let pos = top_left + (size - menu_size) / 2;
        draw_texture_flip_frame(tex.tiles, pos, false, false,
            (0, 13 * 16, menu_size.x, menu_size.y), colors.player);

        button_retry.draw(top_left);
        button_menu.draw(top_left);
    }
    else if game_state == GS_WIN {
        let menu_size = (3, 1) * 16;
        let pos = top_left + (size - menu_size) / 2;
        draw_texture_flip_frame(tex.tiles, pos, false, false,
            (0, 12 * 16, menu_size.x, menu_size.y), colors.player);

        button_continue.draw(top_left);
        button_done.draw(top_left);
    }
    else if game_state == GS_PAUSE {
        let menu_size = (3, 1) * 16;
        let pos = top_left + (size - menu_size) / 2;
        draw_texture_flip_frame(tex.tiles, pos, false, false,
            (3 * 16, 12 * 16, menu_size.x, menu_size.y), colors.player);

        button_continue.draw(top_left);
        button_menu.draw(top_left);
    }
}