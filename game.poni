class SoundNormal {
    var sound: Sound;
    var volume: float = 1.0;

    fun play() {
        play_sound_once(sound);
        set_sound_volume(sound, volume);
    }
}

class SoundAccumulator {
    var queued: int = 0;
    let queued_max: int = 1;

    var sound: Sound;
    var volume: float = 1.0;

    fun play() {
        queued += 1;
        if queued > queued_max { queued = queued_max; }
    }
    fun update_post() {
        if queued > 0 {
            play_sound_once(sound);
            set_sound_volume(sound, volume);
            queued -= 1;
        }
    }
}

let tex = { set_default_filter_mode(FILTER_NEAREST); new Textures{} };
