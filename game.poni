class CameraController {
    var x_bound: vec2 = (0, 0);
    var y_bound: vec2 = (0, 0);

    fun ready_draw(player_pos: vec2) {
        let min_x = x_bound.0 + screen.target_size.x / 2;
        let max_x = x_bound.1 - screen.target_size.x / 2;

        let min_y = y_bound.0 + screen.target_size.y / 2;
        let max_y = y_bound.1 - screen.target_size.y / 2;

        var x = player_pos.x;
        var y = player_pos.y;
        if x < min_x { x = min_x; }
        if x > max_x { x = max_x; }
        if max_x < min_x {
            x = (min_x + max_x) / 2;
        }

        if y < min_y { y = min_y; }
        if y > max_y { y = max_y; }
        if max_y < min_y {
            y = (min_y + max_y) / 2;
        }

        screen.target_offset = -(x, y);

        // Draw a bordering black rectangle around the entire map.
        // This is so we don't have to manually set this up in Tiled.
        //let map = world_loader.cur_map else return;
        let size = world_loader.map_size * 16;
        let TILE_DARK_BORDER = (#1c1c1bff);
        let BORDER_SIZE = 16 * 32;
        // left and right strips
        draw_rectangle((x_bound.0 - BORDER_SIZE, -BORDER_SIZE), (BORDER_SIZE, size.y + BORDER_SIZE * 2), TILE_DARK_BORDER);
        draw_rectangle((x_bound.1, -BORDER_SIZE), (BORDER_SIZE, size.y + BORDER_SIZE * 2), TILE_DARK_BORDER);
        // top and bottom strips
        draw_rectangle((-BORDER_SIZE, y_bound.0 - BORDER_SIZE), (size.x + BORDER_SIZE * 2, BORDER_SIZE), TILE_DARK_BORDER);
        draw_rectangle((-BORDER_SIZE, y_bound.1), (size.x + BORDER_SIZE * 2, BORDER_SIZE), TILE_DARK_BORDER);
    }
}
let camera_controller = new CameraController{};

/// Helper for key just pressed checking due to weird update() system.
class Key {
    var was_down: bool = false;
    var is_down: bool = false;
    var is_just_pressed: bool = false;
    let keycode: int;

    fun update() {
        was_down = is_down;
        is_down = is_key_down(keycode);
        is_just_pressed = is_down and not was_down;
    }
}

let key_space = new Key { keycode: K_SPACE };
let key_x = new Key { keycode: K_X };
let key_r = new Key { keycode: K_R };
let key_z = new Key { keycode: K_Z };
let keys = [key_space, key_x, key_r, key_z];

class Animation {
    let frames: Array[int];
    var frame: int = 0;
    var frame_duration: float;
    var accumulator: float = 0;

    fun update_dt(dt: float) -> bool {
        accumulator += dt;
        if accumulator >= frame_duration {
            accumulator -= frame_duration;
            frame = (frame + 1) % frames.length;

            return true;           
        }
        false
    }

    fun get_frame() -> int { frames[frame] }
}

fun gravity(y_vel: float, dt: float) -> float {
    y_vel += dt * 500.0;
    if y_vel > 200 {
        y_vel = 200;
    }
    y_vel
}

class Player {
    var pos: vec2 = (0, 0);
    var bullet_timer: float = 0;

    fun update_dt(dt: float) {
        var vel: vec2 = norm2((
            if is_key_down(K_LEFT) { -1 } else if is_key_down(K_RIGHT) { 1 } else { 0 },
            if is_key_down(K_UP) { -1 } else if is_key_down(K_DOWN) { 1 } else { 0 }
        ));

        pos += vel * dt * 100;

        bullet_timer -= dt;
        while bullet_timer <= 0 and false {
            //bullet_timer += 0.3; //0.05;
            var b = bullets.spawn();
            b.pos = pos;
            b.vel = norm2((randf_range(-1, 1), randf_range(-1, 1))) * 110.0;
            b.lifetime = 1.2;
        }
    }

    fun draw() {
        //draw_rectangle(pos, pos + (1, 1), (#ffff));
        draw_texture_flip_frame(tex.tiles, pos, false, false, (16, 0, 16, 16), (#ffff))
    }
}

class Enemy {
    var idx: int;
    var alive: bool = true;
    var pos: vec2 = (0, 0);

    fun update_dt(dt: float) {
        let dir = (player.pos - pos);
        pos += norm2(dir) * 50.0 * dt;

        // TODO: Find bullets using a spatial hash or something
        for i in 0..bullets.alive {
            let dif = pos - bullets.bullets[i].pos;
            if dot2(dif, dif) < 6 * 6 {
                enemies.kill(self);
            }
        }

        repel_with_others();
    }

    fun draw() {
        draw_texture_flip_frame(tex.tiles, pos, false, false, (32, 0, 16, 16), (#ffff))
    }

    fun compute_repel_strength(enemy: Enemy) -> vec2 {
        let dir = enemy.pos - pos;
        let len_square = dot2(dir, dir);
        if len_square > 128 * 128 {
            return (0, 0);
        }
        let strength = 0.009 / (1 + 0.0007 * len_square);

        dir * -strength
    }

    fun repel_with_others() {
        var offset: vec2 = (0, 0);

        // TODO: Use spatial hash to find candidates.
        for i in 0..enemies.alive {
            let enemy = enemies.enemies[i];
            if enemy != self {
                offset += compute_repel_strength(enemy);
            }
        }

        pos += offset;
    }
}

class EnemyList {
    let enemies: DynArray[Enemy] = [];
    var alive: int = 0;

    fun spawn() -> Enemy {
        if alive < enemies.length {
            alive += 1;
            enemies[alive - 1].alive = true;
            enemies[alive - 1].idx = alive - 1;
            enemies[alive - 1]
        }
        else {
            alive += 1;
            let result = new Enemy { idx: enemies.length };
            enemies.push(result);
            result
        }
    }

    fun spawn_random_pos(count: int) {
        for i in 0..count {
            let e = spawn();
            e.pos = (randf_range(-1000, 1000), randf_range(-1000, 1000));
        }
    }

    fun iter() -> fun() -> Enemy? {
        var i = 0;

        fun() -> Enemy? {
            if i >= alive { return nil; }
            var next = i;
            i += 1;
            enemies[next]
        }
    }

    fun kill(b: Enemy) {
        if not b.alive {
            return;
        }

        //print("kill ", b.idx);

        //print("swapping ", alive - 1, " (", bullets[alive - 1].idx, ") with ", b.idx, " - ", (bullets[b.idx] == b));
        var tmp = enemies[alive - 1];
        enemies[alive - 1] = enemies[b.idx];
        enemies[b.idx] = tmp;

        tmp.idx = b.idx;

        b.idx = alive - 1;
        b.alive = false;
        alive -= 1;

        //print("dec -> ", alive);
    }
}

let enemies = new EnemyList{};

class Bullet {
    var idx: int;
    var alive: bool = true;
    var pos: vec2 = (0, 0);
    var vel: vec2 = (0, 0);
    var lifetime: float = 0.0;

    fun update_dt(dt: float) {
        pos += vel * dt;
        lifetime -= dt;
        if lifetime <= 0 {
            bullets.kill(self);
        }
    }

    fun draw() {
        draw_texture_flip_frame(tex.tiles, pos, false, false, (48, 0, 16, 16), (#ffff))
    }
}

class BulletList {
    let bullets: DynArray[Bullet] = [];
    var alive: int = 0;

    fun spawn() -> Bullet {
        if alive < bullets.length {
            alive += 1; //print("inc recycle ", alive);
            bullets[alive - 1].alive = true;
            bullets[alive - 1].idx = alive - 1;
            bullets[alive - 1]
        }
        else {
            alive += 1; //print("inc new ", alive);
            let result = new Bullet { idx: bullets.length };
            bullets.push(result);
            result
        }
    }

    fun update_dt(dt: float) {
        for i in 0..alive {
            bullets[i].update_dt(dt);
        }
    }

    fun draw() {
        for i in 0..alive {
            bullets[i].draw();
        }
    }

    fun kill(b: Bullet) {
        if not b.alive {
            return;
        }

        //print("kill ", b.idx);

        //print("swapping ", alive - 1, " (", bullets[alive - 1].idx, ") with ", b.idx, " - ", (bullets[b.idx] == b));
        var tmp = bullets[alive - 1];
        bullets[alive - 1] = bullets[b.idx];
        bullets[b.idx] = tmp;

        tmp.idx = b.idx;

        b.idx = alive - 1;
        b.alive = false;
        alive -= 1;

        //print("dec -> ", alive);
    }
}

let bullets = new BulletList{};

class WorldLoader {
    var pending: StringLoader? = nil;
    var cur_map: Map? = nil;
    var pending_for_pull: StrBuf? = nil;
    var map_size: vec2i = (0, 0);
    var should_load = false;

    var level_idx: int = 0; //level_list.length - 3;
    var won: bool = false; // Set when we make the first call to advance_level() this level.

    let external_tileset = load_string("level/tiles.tsj");
    let external_tileset_name: StrBuf = "tiles.tsj";

    fun load_world_s(loader: StringLoader?) {
        pending = loader;
        should_load = true;

        screen_transition.trigger();
        screen_transition.waiting_on_world = true;
    }

    fun load_world(path: StrBuf) {
        //pending = load_string(path);
        pending_for_pull = path;
        should_load = true;

        screen_transition.trigger();
        screen_transition.waiting_on_world = true;
    }

    fun reload() {
        should_load = true;
        // NOTE: This will not overwrite an advance_level() because we already set should_load in
        // load_world.
        screen_transition.trigger();
        screen_transition.waiting_on_world = true;
    }

    fun advance_level() {
        if won { return; }
        won = true;

        if level_idx + 1 < level_list.length { level_idx += 1; }
        else {
            // Last level is a bonus level that wraps back around to the win screen.
            level_idx = level_list.length - 2;
        }
        load_world(level_list[level_idx]);
        screen_transition.trigger();
        screen_transition.waiting_on_world = true;
    }

    fun tick() {
        if not screen_transition.is_ready() { return; }
        if pending_for_pull.is_some() {
            pending = load_string(pending_for_pull.or_panic());
            pending_for_pull = nil;
        }
        if not should_load { return; }
        
        let pending_ = pending else return;
        let data = get_loaded_string(pending_);
        let data = data else return;

        let external_tileset = get_loaded_string(external_tileset) else return;
        print(external_tileset);

        let map = load_map_with_tilesets(data,
            [{ let x: StrBuf = "../tex/tiles.png"; x }], [tex.tiles],
            [external_tileset_name], [external_tileset]);

        cur_map = map;
        should_load = false;

        let map = map else return;
        map_size = get_tile_map_size(map);

        physics_layer.colliders = [];
        physics_layer.width = map_size.x;

        areas_layer.colliders = [];
        areas_layer.width = map_size.x;
        world.actors = [];
        world.solids = [];

        screen_transition.waiting_on_world = false;

        won = false;

        camera_controller.x_bound.0 = 0;
        camera_controller.x_bound.1 = map_size.x * 16;
        camera_controller.y_bound.0 = 0;
        camera_controller.y_bound.1 = map_size.y * 16;

        for y in 0..map_size.y {
            for x in 0..map_size.x {
                var tile = get_tile_map_tile(map, "main", (x, y));

                print(tile);
                
                fun map_to_physics(tile: int) -> int {
                    if tile == -1 { return T_EMPTY; }
                    return T_SOLID;
                }

                physics_layer.colliders.push(map_to_physics(tile));
            }
        }
    }

    fun draw_bg() {
        let map = cur_map else return;
        let size = map_size * 16;

        // draw_map(map, "bg", (0, 0, size.x, size.y));
        // draw_map(map, "bg2", (0, 0, size.x, size.y));
    }

    fun draw() {
        let map = cur_map else return;
        let size = map_size * 16;
        draw_map(map, "main", (0, 0, size.x, size.y));
        // draw_map(map, "fg", (0, 0, size.x, size.y));
    }
}

